rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // general helpers

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn()
        && request.auth.uid == userId;
    }

    function myUserExists() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        );
    }

    function myUser() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    function isAdmin() {
      return signedIn()
        && myUserExists()
        && myUser().data.get('admin', false) == true
        && myUser().data.get('deleted', false) == false;
    }

    function validCategory(category) {
      return category in [
        'ROAD',
        'LIGHTING',
        'HAZARDS',
        'VANDALISM',
        'SAFETY',
        'OTHER'
      ];
    }

    function validCoordinates(latitude, longitude) {
      return latitude >= -90
        && latitude <= 90
        && longitude >= -180
        && longitude <= 180;
    }

    // users

    match /users/{userId} {

      // full user profiles are private
      allow read:
        if isOwner(userId)
        || isAdmin();

      // authenticated users may create only their own profile
      allow create:
        if isOwner(userId)

        && request.resource.data.keys().hasOnly([
          'anonymousReporting',
          'darkMode',
          'official',
          'admin',
          'deleted',
          'email',
          'displayName',
          'pfpUrl',
          'timestamp'
        ])

        && request.resource.data.get(
          'admin',
          false
        ) == false

        && request.resource.data.get(
          'official',
          false
        ) == false

        && request.resource.data.get(
          'deleted',
          false
        ) == false

        && request.resource.data.get(
          'darkMode',
          false
        ) is bool

        && request.resource.data.get(
          'anonymousReporting',
          false
        ) is bool

        && request.resource.data.timestamp
          is timestamp;

      // users may only modify profile and preferences
      allow update:
        if isOwner(userId)

        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'darkMode',
            'anonymousReporting',
            'displayName',
            'pfpUrl'
          ])

        && request.resource.data.get(
          'darkMode',
          false
        ) is bool

        && request.resource.data.get(
          'anonymousReporting',
          false
        ) is bool;

      allow delete:
        if false;

      // important locations

      match /importantLocations/{locationId} {

        function validLocationType(type) {
          return type in [
            'HOME',
            'WORK',
            'SCHOOL',
            'CUSTOM'
          ];
        }

        function validLocationIdForType(type) {

          return (
            type == 'HOME'
            && locationId == 'home'
          )

          || (
            type == 'WORK'
            && locationId == 'work'
          )

          || (
            type == 'SCHOOL'
            && locationId == 'school'
          )

          || (
            type == 'CUSTOM'

            && !(locationId in [
              'home',
              'work',
              'school'
            ])
          );
        }

        allow read:
          if isOwner(userId);

        allow create:
          if isOwner(userId)

          && request.resource.data.keys().hasOnly([
            'name',
            'type',
            'latitude',
            'longitude',
            'geohash',
            'displayAddress',
            'createdAt',
            'updatedAt'
          ])

          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 100

          && validLocationType(
            request.resource.data.type
          )

          && validLocationIdForType(
            request.resource.data.type
          )

          && validCoordinates(
            request.resource.data.latitude,
            request.resource.data.longitude
          )

          && request.resource.data.geohash is string
          && request.resource.data.geohash.size() > 0
          && request.resource.data.geohash.size() <= 30

          && request.resource.data.displayAddress is string
          && request.resource.data.displayAddress.size() <= 1000

          && request.resource.data.createdAt
            == request.time

          && request.resource.data.updatedAt
            == request.time;

        allow update:
          if isOwner(userId)

          && request.resource.data.keys().hasOnly([
            'name',
            'type',
            'latitude',
            'longitude',
            'geohash',
            'displayAddress',
            'createdAt',
            'updatedAt'
          ])

          && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'name',
              'type',
              'latitude',
              'longitude',
              'geohash',
              'displayAddress',
              'updatedAt'
            ])

          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 100

          && validLocationType(
            request.resource.data.type
          )

          && validLocationIdForType(
            request.resource.data.type
          )

          && validCoordinates(
            request.resource.data.latitude,
            request.resource.data.longitude
          )

          && request.resource.data.geohash is string
          && request.resource.data.geohash.size() > 0
          && request.resource.data.geohash.size() <= 30

          && request.resource.data.displayAddress is string
          && request.resource.data.displayAddress.size() <= 1000

          && request.resource.data.createdAt
            == resource.data.createdAt

          && request.resource.data.updatedAt
            == request.time;

        allow delete:
          if isOwner(userId);
      }
    }

    // reports

    match /reports/{reportId} {

      // raw reports contain user id and exact coordinates so other users cannot read them
      allow read:
        if signedIn()

        && (
          resource.data.userId
            == request.auth.uid

          || isAdmin()
        );

      allow create:
        if signedIn()
        && myUserExists()

        && request.resource.data.keys().hasOnly([
          'userId',
          'anonymous',
          'isAnonymous',
          'eventId',
          'category',
          'severity',
          'description',
          'photoURL',
          'latitude',
          'longitude',
          'geohash',
          'status',
          'createdAt'
        ])

        && request.resource.data.userId
          == request.auth.uid

        // supports both anonymous and isanonymous fields
        && (
          (
            'anonymous'
              in request.resource.data

            && !(
              'isAnonymous'
                in request.resource.data
            )

            && request.resource.data.anonymous
              is bool

            && request.resource.data.anonymous
              == myUser().data.get(
                'anonymousReporting',
                false
              )
          )

          ||

          (
            'isAnonymous'
              in request.resource.data

            && !(
              'anonymous'
                in request.resource.data
            )

            && request.resource.data.isAnonymous
              is bool

            && request.resource.data.isAnonymous
              == myUser().data.get(
                'anonymousReporting',
                false
              )
          )
        )

        && request.resource.data.eventId
          is string

        && request.resource.data.eventId.size()
          > 0

        && validCategory(
          request.resource.data.category
        )

        && request.resource.data.severity
          is int

        && request.resource.data.severity >= 1
        && request.resource.data.severity <= 10

        && request.resource.data.description
          is string

        && request.resource.data.description.size()
          <= 5000

        && request.resource.data.photoURL
          is string

        && request.resource.data.photoURL.size()
          <= 3000

        && validCoordinates(
          request.resource.data.latitude,
          request.resource.data.longitude
        )

        && request.resource.data.geohash
          is string

        && request.resource.data.geohash.size()
          > 0

        && request.resource.data.geohash.size()
          <= 30

        && request.resource.data.status
          == 'PENDING'

        && request.resource.data.createdAt
          is timestamp

        && existsAfter(
          /databases/$(database)/documents/events/$(request.resource.data.eventId)
        )

        && request.auth.uid
          in getAfter(
            /databases/$(database)/documents/events/$(request.resource.data.eventId)
          ).data.reporterIds

        && getAfter(
          /databases/$(database)/documents/events/$(request.resource.data.eventId)
        ).data.category
          == request.resource.data.category;

      // editing or deleting reports is not allowed
      allow update, delete:
        if false;
    }

    // events

    match /events/{eventId} {

      function validEventCreate() {

        return request.resource.data.keys().hasOnly([
          'category',
          'status',

          'averageSeverity',
          'totalSeveritySum',

          'uniqueUserCount',
          'reportCount',
          'reporterIds',

          'voteScore',

          'locationAccuracy',
          'radiusMeters',
          'latitude',
          'longitude',
          'geohash',

          'photoGallery',
          'topCommentText',
          'topCommentUserId',
          'commentCount',

          'resolvedBy',
          'resolvedAt',

          'createdAt',
          'updatedAt'
        ])

        && validCategory(
          request.resource.data.category
        )

        // direct creation as active is prohibited
        && request.resource.data.status
          == 'PENDING'

        && request.resource.data.averageSeverity
          >= 1

        && request.resource.data.averageSeverity
          <= 10

        && request.resource.data.totalSeveritySum
          == request.resource.data.averageSeverity

        && request.resource.data.uniqueUserCount
          is int

        && request.resource.data.uniqueUserCount
          == 1

        && request.resource.data.reportCount
          is int

        && request.resource.data.reportCount
          == 1

        && request.resource.data.reporterIds
          is list

        && request.resource.data.reporterIds.size()
          == 1

        && request.resource.data.reporterIds[0]
          == request.auth.uid

        && request.resource.data.voteScore
          == 0

        && request.resource.data.locationAccuracy
          in [
            'pinpoint',
            'general'
          ]

        && request.resource.data.radiusMeters
          >= 0

        && validCoordinates(
          request.resource.data.latitude,
          request.resource.data.longitude
        )

        && request.resource.data.geohash
          is string

        && request.resource.data.geohash.size()
          > 0

        && request.resource.data.geohash.size()
          <= 30

        && request.resource.data.photoGallery
          is list

        && request.resource.data.photoGallery.size()
          <= 1

        && request.resource.data.commentCount
          == 0

        && request.resource.data.get(
          'resolvedBy',
          null
        ) == null

        && request.resource.data.get(
          'resolvedAt',
          null
        ) == null

        && request.resource.data.createdAt
          is timestamp

        && request.resource.data.updatedAt
          is timestamp;
      }

      // adding a report may only update event aggregation fields
      function validReportAggregationUpdate() {

        let oldUnique =
          resource.data.uniqueUserCount;

        let newUnique =
          request.resource.data.uniqueUserCount;

        let oldReports =
          resource.data.reportCount;

        let newReports =
          request.resource.data.reportCount;

        let oldSeverity =
          resource.data.totalSeveritySum;

        let newSeverity =
          request.resource.data.totalSeveritySum;

        let addedSeverity =
          newSeverity - oldSeverity;

        return signedIn()
          && resource.data.status in ['PENDING', 'ACTIVE']

          && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'reporterIds',
              'uniqueUserCount',
              'reportCount',
              'totalSeveritySum',
              'averageSeverity',
              'photoGallery',
              'updatedAt',
              'status'
            ])

          && !(
            request.auth.uid
              in resource.data.reporterIds
          )

          && request.resource.data.reporterIds
            is list

          && request.resource.data.reporterIds.hasAll(
            resource.data.reporterIds
          )

          && request.resource.data.reporterIds.size()
            == resource.data.reporterIds.size() + 1

          && request.auth.uid
            in request.resource.data.reporterIds

          && oldUnique is int
          && newUnique is int

          && newUnique
            == oldUnique + 1

          && oldReports is int
          && newReports is int

          && newReports
            == oldReports + 1

          && addedSeverity >= 1
          && addedSeverity <= 10

          && request.resource.data.averageSeverity
            >= 1

          && request.resource.data.averageSeverity
            <= 10

          // photos cannot be removed and at most one can be added per report
          && request.resource.data.photoGallery
            is list

          && request.resource.data.photoGallery.hasAll(
            resource.data.photoGallery
          )

          && request.resource.data.photoGallery.size()
            >= resource.data.photoGallery.size()

          && request.resource.data.photoGallery.size()
            <= resource.data.photoGallery.size() + 1

          && request.resource.data.updatedAt
            is timestamp

          // status becomes active at 3 or more unique reports
          && (
            (
              newUnique < 3

              && request.resource.data.status
                == resource.data.status
            )

            ||

            (
              newUnique >= 3

              && request.resource.data.status
                == 'ACTIVE'
            )
          );
      }

      function validCommentCountIncrement() {

        return signedIn()
          && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'commentCount'
          ])

          && request.resource.data.commentCount
            is int

          && request.resource.data.commentCount
            == resource.data.get(
              'commentCount',
              0
            ) + 1;
      }

      // restricts vote score updates to valid deltas (-2, -1, 1, 2)
      function validVoteScoreUpdate() {

        let oldScore =
          resource.data.get(
            'voteScore',
            0
          );

        let newScore =
          request.resource.data.voteScore;

        let delta =
          newScore - oldScore;

        return signedIn()
          && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'voteScore'
          ])

          && newScore is int

          && (
            delta == -2
            || delta == -1
            || delta == 1
            || delta == 2
          );
      }

      // allows signed-in users to read events
      allow read:
        if signedIn();

      allow create:
        if signedIn()
        && validEventCreate();

      // The admin may resolve an active event; evidence and totals stay intact.
      function validAdminResolution() {
        return isAdmin()
          && resource.data.status == 'ACTIVE'
          && request.resource.data.status == 'FIXED'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'resolvedBy', 'resolvedAt', 'updatedAt'
          ])
          && request.resource.data.resolvedBy == request.auth.uid
          && request.resource.data.resolvedAt == request.time
          && request.resource.data.updatedAt == request.time;
      }

      allow update:
        if validAdminResolution()

        || validReportAggregationUpdate()

        || validCommentCountIncrement()

        || validVoteScoreUpdate();

      allow delete:
        if false;

      // event votes

      match /votes/{uid} {

        function validVote() {

          return request.resource.data.keys().hasOnly([
            'vote',
            'createdAt'
          ])

          && request.resource.data.vote
            is int

          && request.resource.data.vote
            in [
              -1,
              1
            ]

          && request.resource.data.createdAt
            is timestamp;
        }

        allow read:
          if signedIn()
          && request.auth.uid == uid;

        allow create, update:
          if signedIn()
          && request.auth.uid == uid
          && validVote();

        allow delete:
          if signedIn()
          && request.auth.uid == uid;
      }

      // comments

      match /comments/{commentId} {

        function validNewComment() {

          return request.resource.data.keys().hasOnly([
              'userId',
              'displayName',
              'pfpUrl',
              'isAnonymous',
              'text',
              'heartCount',
              'status',
              'edited',
              'createdAt',
              'updatedAt'
            ])

            && request.resource.data.userId
              == request.auth.uid

            && request.resource.data.displayName
              is string

            && request.resource.data.displayName.size()
              > 0

            && request.resource.data.displayName.size()
              <= 100

            && request.resource.data.pfpUrl
              is string

            && request.resource.data.pfpUrl.size()
              <= 3000

            && request.resource.data.isAnonymous
              is bool

            && request.resource.data.isAnonymous
              == myUser().data.get(
                'anonymousReporting',
                false
              )

            && (
              request.resource.data.isAnonymous
                == false

              || (
                request.resource.data.displayName
                  == 'Anonymous'

                && request.resource.data.pfpUrl
                  == ''
              )
            )

            && request.resource.data.text
              is string

            && request.resource.data.text.size()
              > 0

            && request.resource.data.text.size()
              <= 1000

            && request.resource.data.heartCount
              == 0

            && request.resource.data.status
              == 'active'

            && request.resource.data.edited
              == false

            && request.resource.data.createdAt
              == request.time

            && request.resource.data.updatedAt
              == request.time

            // comment creation must be committed together with event comment count increment
            && getAfter(
              /databases/$(database)/documents/events/$(eventId)
            ).data.commentCount

            == get(
              /databases/$(database)/documents/events/$(eventId)
            ).data.get(
              'commentCount',
              0
            ) + 1;
        }

        function validHeartCountUpdate() {

          let oldCount =
            resource.data.get(
              'heartCount',
              0
            );

          let newCount =
            request.resource.data.heartCount;

          return request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'heartCount'
            ])

            && oldCount is int
            && newCount is int
            && newCount >= 0

            && (
              (
                newCount
                  == oldCount + 1

                && !exists(
                  /databases/$(database)/documents/events/$(eventId)/comments/$(commentId)/hearts/$(request.auth.uid)
                )

                && existsAfter(
                  /databases/$(database)/documents/events/$(eventId)/comments/$(commentId)/hearts/$(request.auth.uid)
                )
              )

              ||

              (
                oldCount > 0

                && newCount
                  == oldCount - 1

                && exists(
                  /databases/$(database)/documents/events/$(eventId)/comments/$(commentId)/hearts/$(request.auth.uid)
                )

                && !existsAfter(
                  /databases/$(database)/documents/events/$(eventId)/comments/$(commentId)/hearts/$(request.auth.uid)
                )
              )
            );
        }

        allow read:
          if signedIn();

        allow create:
          if signedIn()
          && myUserExists()
          && validNewComment();

        // only heart count updates are allowed
        allow update:
          if signedIn()
          && validHeartCountUpdate();

        allow delete:
          if false;

        // comment hearts

        match /hearts/{uid} {

          allow read:
            if signedIn()
            && request.auth.uid == uid;

          allow create:
            if signedIn()

            && request.auth.uid == uid

            && request.resource.data.keys().hasOnly([
              'userId',
              'createdAt'
            ])

            && request.resource.data.userId
              == uid

            && request.resource.data.createdAt
              == request.time

            && getAfter(
              /databases/$(database)/documents/events/$(eventId)/comments/$(commentId)
            ).data.heartCount

            == get(
              /databases/$(database)/documents/events/$(eventId)/comments/$(commentId)
            ).data.get(
              'heartCount',
              0
            ) + 1;

          allow delete:
            if signedIn()

            && request.auth.uid == uid

            && resource.data.userId
              == uid

            && getAfter(
              /databases/$(database)/documents/events/$(eventId)/comments/$(commentId)
            ).data.heartCount

            == get(
              /databases/$(database)/documents/events/$(eventId)/comments/$(commentId)
            ).data.get(
              'heartCount',
              0
            ) - 1;

          allow update:
            if false;
        }
      }
    }
  }
}
