<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <!-- Drag handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_bottom_sheet_handle" />


        <!-- Title -->
        <TextView
            android:id="@+id/tv_location_editor_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Add Location"
            android:textColor="@color/tertiary"
            android:textSize="21sp"
            android:textStyle="bold" />


        <!-- ================================================= -->
        <!-- CUSTOM NAME                                       -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/layout_location_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.06"
                android:text="NAME"
                android:textColor="@color/tertiary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_location_name"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_location_name_input"
                android:gravity="center_vertical"
                android:hint="Location name"
                android:inputType="textCapWords"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/tertiary"
                android:textColorHint="@color/textSecondary"
                android:textSize="14sp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- LOCATION                                          -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:letterSpacing="0.06"
            android:text="LOCATION"
            android:textColor="@color/tertiary"
            android:textSize="12sp"
            android:textStyle="bold" />


        <!-- Map preview -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="@color/popupCardBackground"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <com.google.android.gms.maps.MapView
                    android:id="@+id/map_location_preview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Tapping the map opens LocationPickerActivity -->
                <View
                    android:id="@+id/map_click_overlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_map_hint"
                    android:paddingStart="10dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="6dp"
                    android:text="Tap map to choose location"
                    android:textColor="@color/tertiary"
                    android:textSize="11sp" />

            </FrameLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- Address -->
        <TextView
            android:id="@+id/tv_location_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="No location selected"
            android:textColor="@color/textSecondary"
            android:textSize="13sp" />


        <!-- ================================================= -->
        <!-- CURRENT LOCATION                                  -->
        <!-- SAME STYLE AS REPORT                              -->
        <!-- ================================================= -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_use_current_location"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="18dp"
            android:text="Use Current Location"
            android:textAllCaps="false"
            android:textColor="@color/tertiary"
            android:textSize="14sp"
            app:backgroundTint="@color/button"
            app:cornerRadius="8dp"
            app:icon="@drawable/ic_my_location"
            app:iconGravity="textStart"
            app:iconTint="@color/primary" />


        <!-- ================================================= -->
        <!-- ACTIONS                                           -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">


            <!-- REMOVE -->
            <TextView
                android:id="@+id/btn_remove_location"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_remove_location_outline"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="88dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Remove"
                android:textColor="@color/heart"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />


            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />


            <!-- CANCEL -->
            <TextView
                android:id="@+id/btn_cancel_location"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Cancel"
                android:textColor="@color/textSecondary"
                android:textSize="13sp"
                android:textStyle="bold" />


            <!-- SAVE -->
            <TextView
                android:id="@+id/btn_save_location"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_location_save_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="78dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="Save"
                android:textColor="@color/background"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>